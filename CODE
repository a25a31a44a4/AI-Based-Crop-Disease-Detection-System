// Simulated "AI prediction" from image filename
int predictFromImage(const string &imagePath, int totalDiseases)
{
    string lower = imagePath;
    
    // Fixed loop to work in older C++ standards as well
    for (size_t i = 0; i < lower.length(); i++) {
        lower[i] = tolower(lower[i]);
    }

    if (lower.find("early") != string::npos)   return 1;
    if (lower.find("late") != string::npos)    return 2;
    if (lower.find("mold") != string::npos)    return 3;
    if (lower.find("spot") != string::npos)    return 4;
    if (lower.find("blight") != string::npos)  return 1;
    if (lower.find("blast") != string::npos)   return 1;
    if (lower.find("wilt") != string::npos)    return 2;
    if (lower.find("rust") != string::npos)    return 2;
    if (lower.find("mildew") != string::npos)  return 3;

    return 1; // Default fallback
}

